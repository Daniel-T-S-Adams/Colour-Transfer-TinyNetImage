# ------------ User-specific additions -----------

# Ignore all downloaded data and intermediate files
/data/*
# Keep the directory, but ignore its contents, except for .gitkeep
!/data/.gitkeep

# Ignore all generated output images
/outputs/*
# Keep the directory, but ignore its contents, except for .gitkeep
!/outputs/.gitkeep

# Ignore specific OS files
.DS_Store
Thumbs.db 